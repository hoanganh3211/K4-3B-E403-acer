LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional compatible endpoint; leave blank for OpenAI.
OPENAI_BASE_URL=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Gemini checks lesson suitability before research, even with another LLM_PROVIDER.
# Uses GOOGLE_API_KEY; leave blank to use GOOGLE_MODEL for this short check.
MODERATION_MODEL=
TAVILY_API_KEY=
LLM_TIMEOUT_SECONDS=90
SEARCH_TIMEOUT_SECONDS=25
MAX_TOKENS=12000
RESEARCH_MAX_CHARS=24000
WORDS_PER_MINUTE=140
# UI points to the local API by default.
SCRIPTSCOUT_API_URL=http://localhost:8000
